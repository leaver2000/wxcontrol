# Copy to .env and adjust. Everything has a default in docker-compose.yml.

# --- object store (SeaweedFS S3 gateway) ---
S3_ACCESS_KEY=wxadmin
S3_SECRET_KEY=change-me-please
WX_S3_BUCKET=wxdata
# Set to false only if your S3 server lacks If-Match/If-None-Match support.
WX_S3_CONDITIONAL_WRITES=true

# --- what to ingest ---
WX_MODELS=hrrr,rrfs
# hPa levels: "from-to:step" or a comma list
WX_LEVELS=1000-100:25
# forecast hours per run (HRRR goes to 48 h and RRFS to 84 h on synoptic cycles)
WX_MAX_FHR=18
# "synoptic" (00/06/12/18Z) or "all" (hourly cycles)
WX_CYCLES=synoptic
# 1 = native 3 km grid. 2 halves each dimension (quarter of the storage and ingest cost).
WX_STRIDE=1
# grid thinning for the nzthermo-derived CAPE/CIN/LCL/LI fields
WX_DERIVE_STRIDE=2
WX_RETAIN_RUNS=2
WX_POLL_SECONDS=300

# RRFS v1 operational layout on noaa-rrfs-ops-pds. Adjust here if NOAA's bucket layout differs.
WX_RRFS_PATH=rrfs.{date}/{cycle:02d}/rrfs.t{cycle:02d}z.{product}.3km.f{fhr:03d}.conus.grib2

CLIENT_PORT=8080
